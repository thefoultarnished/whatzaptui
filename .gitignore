# User-specific files
.claude/
.commandcode/
screenshots/
docs/

# Keep only the root project README tracked.
*.md
!/README.md

# Build artifacts & binaries
*.exe
*.exe~
*.out
*.so
*.dylib
dist/

# Go cache
.whatsmeow_cache/
go.sum.bak
*.mod.bak
.whatzap_tui_config.json

# Logs
*.log

# Secrets / local config
.env
.env.*
*.pem
*.key
*.p12
*.pfx

# Local DB artifacts
*.db
*.db-*
*.sqlite
*.sqlite3

# Stray shell-redirect artifacts (e.g. a PowerShell command misparsed as a
# literal filename)
$null
*.received.txt
